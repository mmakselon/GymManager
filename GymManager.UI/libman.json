{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "provider": "jsdelivr",
      "library": "cldrjs@0.5.5",
      "destination": "wwwroot/lib/cldrjs/",
      "files": [
        "dist/cldr.js",
        "dist/cldr/event.js",
        "dist/cldr/supplemental.js"
      ]
    },
    {
      "provider": "cdnjs",
      "library": "globalize@1.7.0",
      "destination": "wwwroot/lib/globalize/",
      "files": [
        "globalize/date.js",
        "globalize.js",
        "globalize/number.js"
      ]
    }
  ]
}